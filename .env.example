# ============================================
# Connecting - 환경변수 설정
# ============================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
#   cp .env.example .env

# ---- 데이터베이스 ----
# PostgreSQL 연결 URL
DATABASE_URL="postgresql://user:password@localhost:5432/connecting?schema=public"

# ---- Next.js 서버 ----
# 호스트 및 포트
HOST=localhost
PORT=3000

# HTTPS 사용 여부 (true/false)
# true로 설정 시 certificates/ 폴더에 인증서 필요
HTTPS=false

# ---- Socket.IO 서버 ----
# Socket 서버 호스트 및 포트
SOCKET_HOST=localhost
SOCKET_PORT=4000

# Socket HTTP 버전 (HTTP/1, HTTP/2, HTTP/3)
SOCKET_HTTP=HTTP/1

# ---- 인증 ----
# JWT 세션 암호화 키 (반드시 변경하세요)
SESSION_SECRET="your-secret-key-change-this"

# ---- 클라이언트 공개 변수 (NEXT_PUBLIC_) ----
# Next.js 앱 기본 URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Socket.IO 서버 URL (클라이언트에서 접속할 주소)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# mediasoup 서버 공인 IP (WebRTC announcedIp)
# 로컬 개발 시 127.0.0.1, 배포 시 서버 공인 IP로 변경
NEXT_PUBLIC_MEDIASOUP_URL=127.0.0.1
